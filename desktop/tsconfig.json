{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [],
    "typeRoots": [
      "../dashboard/node_modules/@types"
    ],
    "paths": {
      "react": [
        "../dashboard/node_modules/@types/react"
      ],
      "react/jsx-runtime": [
        "../dashboard/node_modules/@types/react/jsx-runtime"
      ]
    }
  },
  "include": [
    "src",
    "../dashboard/src/three-shim.d.ts",
    "assets.d.ts"
  ]
}